{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "checkJs": false,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "exclude": [
    "node_modules",
    "public",
    "dist"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.vue",
    "tests/**/*.spec.js",
    "tests/**/*.vue"
  ]
}
